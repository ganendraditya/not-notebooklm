# ==============================================================================
# NotbookLM - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` and configure your preferred AI credentials.
#
# NotbookLM employs an efficient Two-Tier Architecture:
# - Primary / Heavy LLM: Deep document synthesis, reasoning & literature review
# - Fast / Lite LLM: Real-time query planning, intent classification & paper judging
# - Fallback LLM: Automatic fallback model if primary experiences rate limits or outages
# ==============================================================================

# Active LLM Provider: custom (Universal Gateway, default) | gemini | groq
LLM_PROVIDER=custom

# ==============================================================================
# 1. Universal LLM Gateway (OpenAI-Compatible REST API)
# ==============================================================================
# Connect to ANY model or provider using standard OpenAI format:
# - Official OpenAI (GPT-4o, GPT-4o-mini)
# - OpenRouter (Claude 3.5 Sonnet, DeepSeek R1, Llama 3)
# - Local / Offline (Ollama, LM Studio, vLLM, LocalAI)
# - Multi-Model Gateways (LiteLLM, OneAPI, LocalAI, vLLM)

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here

# [MAIN MODEL]
# Powers core, reasoning-heavy tasks requiring deep academic synthesis:
# - Multi-document synthesis & comparative literature reviews
# - Complex research Q&A with grounded verbatim citations
# - Workspace analysis across uploaded documents
LLM_MODEL=gpt-4o

# [FAST MODEL]
# Lightweight, high-speed model for rapid micro-tasks (low latency & cost):
# - Academic query planning (extracting target language, year range, Scopus/SINTA quartiles)
# - User intent triage & classification (general chat vs search vs workspace analysis)
# - Automated conversation title generation
# - Candidate paper relevance judging & rubric screening
# - Metadata quality auditing (journal indexing prestige & official abstract validation)
LLM_FAST_MODEL=gpt-4o-mini

# [FALLBACK MODEL] (Optional)
# Automatic safety fallback if the Main Model encounters rate limits (429) or timeouts:
LLM_FALLBACK_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# PRESET EXAMPLES (Copy & paste according to your setup):
#
# A. OpenRouter (Access Claude 3.5 Sonnet, DeepSeek R1, Llama 3.3):
#    LLM_BASE_URL=https://openrouter.ai/api/v1
#    LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
#    LLM_MODEL=anthropic/claude-3.5-sonnet
#    LLM_FAST_MODEL=anthropic/claude-3.5-haiku
#    LLM_FALLBACK_MODEL=deepseek/deepseek-chat
#
# B. Local Offline via Ollama:
#    LLM_BASE_URL=http://localhost:11434/v1
#    LLM_API_KEY=ollama
#    LLM_MODEL=llama3.3:70b
#    LLM_FAST_MODEL=llama3.2:3b
#
# C. Local Self-Hosted Gateway / Proxy (e.g., LiteLLM, vLLM, LocalAI):
#    LLM_BASE_URL=http://localhost:8000/v1
#    LLM_API_KEY=sk-local-secret-key
#    LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
#    LLM_FAST_MODEL=meta-llama/Llama-3.1-8B-Instruct
#    LLM_FALLBACK_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# ------------------------------------------------------------------------------

# ==============================================================================
# 2. Native Direct Google Gemini (Direct cloud alternative: https://aistudio.google.com/)
# ==============================================================================
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=models/gemini-3.7-flash             # Main synthesis model
# GEMINI_FAST_MODEL=models/gemini-3.5-flash-lite   # Fast triage & planning model

# ==============================================================================
# 3. Native Direct Groq (Ultra-fast cloud inference: https://console.groq.com/)
# ==============================================================================
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile              # Main synthesis model
# GROQ_FAST_MODEL=llama-3.1-8b-instant            # Fast triage & planning model

# ==============================================================================
# 4. Vector Database (Qdrant)
# Leave empty to use local embedded disk storage (default)
# ==============================================================================
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
