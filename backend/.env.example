# ==============================================================================
# NotbookLM - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` and configure your LLM gateway credentials.
# NotbookLM employs a Two-Tier Architecture:
# - Primary / Heavy LLM: Deep document synthesis, reasoning & literature review
# - Fast / Lite LLM: Real-time query planning, intent classification & paper judging
# - Fallback LLM: Secondary fallback model if primary experiences timeout or failure
# ==============================================================================

# Default active LLM provider (ninerouter | gemini | groq)
LLM_PROVIDER=ninerouter

# ------------------------------------------------------------------------------
# 1. Primary AI Gateway (9Router / OpenAI-compatible endpoint)
# ------------------------------------------------------------------------------
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=your_api_key_here
NINEROUTER_MODEL=ag/gemini-3.8-flash-high
NINEROUTER_FAST_MODEL=ag/gemini-3.8-flash-low
NINEROUTER_FALLBACK_MODEL=ag/gemini-pro-agent

# ------------------------------------------------------------------------------
# 2. Direct Gemini Fallback (Optional)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Vector Database (Qdrant)
# Leave empty to use local embedded disk storage (default)
# ------------------------------------------------------------------------------
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
