# ==============================================================================
# NotbookLM - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` and fill in your preferred provider credentials.
#
# Supported Providers:
# 1. "freellmapi"  -> 100% Free local proxy (Runs on http://localhost:3001)
# 2. "gemini"      -> Google Gemini API (Free tier available at Google AI Studio)
# 3. "groq"        -> Groq Cloud (Free tier available with ultra-fast inference)
# 4. "ninerouter"  -> 9Router multi-model router / OpenAI-compatible endpoint
# ==============================================================================

# Default active LLM provider (freellmapi | gemini | groq | ninerouter)
LLM_PROVIDER=freellmapi

# ------------------------------------------------------------------------------
# 1. FreeLLMAPI Configuration (Recommended for 100% Free Usage)
# ------------------------------------------------------------------------------
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=your_freellmapi_key_here
FREELLMAPI_MODEL=gpt-oss-120b

# ------------------------------------------------------------------------------
# 2. Google Gemini API (Free tier: https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Groq API (Free tier: https://console.groq.com/)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here