# ==============================================================================
# NotbookLM - Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` (or `.env` in root) and configure your credentials.
#
# NotbookLM connects to ANY OpenAI-compatible LLM endpoint or gateway.
# You only need to provide your endpoint URL, API key, and preferred model name(s).
#
# Flexible Model Architecture:
# - Single-model mode: Just set LLM_MODEL. Everything runs on that model seamlessly.
# - Tiered mode: Set LLM_MODEL for heavy reasoning, and LLM_FAST_MODEL for fast micro-tasks.
# - High-availability mode: Optionally add LLM_FALLBACK_MODEL for automatic failover.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Gateway & Credentials (Required)
# ------------------------------------------------------------------------------
# OpenAI-compatible API endpoint URL:
# - Local Gateway / 9Router / LiteLLM / OneAPI: http://localhost:20128/v1
# - Local Ollama: http://localhost:11434/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Official OpenAI: https://api.openai.com/v1
LLM_BASE_URL=http://localhost:20128/v1

# Secret API key / Bearer Token
# (Use "ollama" or dummy key if running a local instance without authentication)
LLM_API_KEY=your_api_key_here

# ------------------------------------------------------------------------------
# 2. Model Roles (Vendor-Neutral)
# ------------------------------------------------------------------------------
# [MODEL 1: PRIMARY / HEAVY MODEL] (Required)
# Powers core reasoning-heavy tasks:
# - Multi-document synthesis & comparative literature reviews
# - Deep research Q&A with grounded verbatim citations
# - Workspace analysis across uploaded documents
LLM_MODEL=gpt-4o

# [MODEL 2: FAST / LITE MODEL] (Optional)
# Powers rapid micro-tasks:
# - Academic query planning (extracting language, year range, quartiles)
# - User intent triage & classification
# - Conversation title generation
# - Paper relevance judging & rubric screening
# NOTE: If left empty or omitted, system automatically uses LLM_MODEL.
LLM_FAST_MODEL=gpt-4o-mini

# [MODEL 3: FALLBACK MODEL] (Optional)
# Automatic safety fallback if the primary model hits rate limits (HTTP 429), timeouts, or errors.
# NOTE: If left empty or omitted, fallback chain gracefully reuses available models.
LLM_FALLBACK_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. Vector Database (Optional)
# ------------------------------------------------------------------------------
# Leave empty to use local embedded disk storage (default, zero-setup required)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
